# Normalize line endings — repo stores LF; these MUST stay LF regardless of
# checkout platform (they run as shell scripts / are parsed by CI on Linux).
* text=auto eol=lf

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# PowerShell is fine with either; keep CRLF as the native Windows convention.
*.ps1  text eol=crlf
